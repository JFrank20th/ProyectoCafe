{
  "Database": {
    "ConnectionString": "Server=localhost;Database=ProyectoCafe;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Auth": {
    "Jwt": {
      "Issuer": "ProyectoCafe",
      "Audience": "ProyectoCafe.Portal",
      "AccessTokenLifetimeMinutes": 480
    },
    "Cookie": {
      "AccessTokenCookieName": "pc_at",
      "CsrfCookieName": "pc_csrf",
      "CsrfHeaderName": "X-CSRF"
    },
    "RateLimit": {
      "Enabled": true,
      "IpMaxFailedAttempts": 20,
      "IpWindowMinutes": 5,
      "UserMaxFailedAttempts": 10,
      "UserWindowMinutes": 15,
      "MaxTrackedKeys": 10000
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
