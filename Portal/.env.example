# ── ProyectoCafe API Backend ─────────────────────────────────────────────────
# Local dev (build-time)
NEXT_PUBLIC_PROYECTOCAFE_API_URL=http://localhost:5000

# Docker/Azure runtime (server-side, injected into window.__RUNTIME_ENV__)
# PROYECTOCAFE_API_URL=https://proyectocafe-api.example.com

# ── App Metadata ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=ProyectoCafe
NEXT_PUBLIC_APP_VERSION=0.1.0
