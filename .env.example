# =============================================================================
# ProyectoCafe — variables para Docker Compose (copia a .env)
# =============================================================================
# .env está en .gitignore: NUNCA lo commitees. Este archivo solo contiene
# marcadores de posición; no incluye secretos reales.
#
# Usa comillas simples para que Compose no interprete $ ni caracteres especiales
# dentro de la cadena de conexión o la clave.
# =============================================================================

# --- Azure SQL ---------------------------------------------------------------
# Cadena de conexión de la base ya existente. Ejemplo de forma (sin valores):
# Server=tcp:<servidor>.database.windows.net,1433;Database=<base>;
# User ID=<usuario>;Password=<password>;Encrypt=True;TrustServerCertificate=False;
DATABASE_CONNECTION_STRING=''

# --- Seguridad de la API -----------------------------------------------------
# Clave HS256 de al menos 32 bytes. Genera una aleatoria (PowerShell):
#   [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_SIGNING_KEY=''

# --- Puertos publicados en el host ------------------------------------------
API_PORT=5000
PORTAL_PORT=3010

# --- URLs del Portal ---------------------------------------------------------
# URL que usa el navegador (se publica en window.__RUNTIME_ENV__).
PROYECTOCAFE_API_URL=http://localhost:5000

# URL que usa el servidor del Portal dentro de la red de Compose.
PROYECTOCAFE_API_URL_INTERNAL=http://api:8080

# Origen exacto del Portal para la allowlist CORS de la API.
PORTAL_PUBLIC_ORIGIN=http://localhost:3010

# --- Opcionales --------------------------------------------------------------
PROYECTOCAFE_AUTH_COOKIE_NAME=pc_at
APP_NAME=ProyectoCafe
API_LOG_LEVEL=Information
